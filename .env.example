# =============================================================================
# AI COMPANION — environment configuration
# Copy to `.env` and fill in only the providers you want to use.
# The LLM router will detect which keys are present and only consider those.
# =============================================================================

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# --- LLM provider keys (provide at least ONE) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# --- LLM router preferences ---
# Comma-separated provider order to prefer when multiple are eligible.
LLM_PREFERENCE_ORDER=anthropic,openai,google,groq,mistral
# Hard cap on tokens per request
LLM_MAX_TOKENS=4096

# --- Voice ---
# ElevenLabs is used for the "Stark-esque" persona voice.
# IMPORTANT: do NOT use a voice clone of any real person without their consent.
# Set ELEVENLABS_VOICE_ID to a voice you own/license, or leave blank to fall
# back to a built-in ElevenLabs preset voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Local STT (faster-whisper) model size: tiny / base / small / medium / large-v3
WHISPER_MODEL=base

# --- Memory ---
MEMORY_DB_PATH=./data/companion.db
CHROMA_PATH=./data/chroma

# --- Agent orchestrator limits ---
AGENT_MAX_PARALLEL=5
AGENT_MAX_DEPTH=3
AGENT_TIMEOUT_SECONDS=120

# --- Telephony (optional, for booking-call agent) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Remote host bridge (for accessing your home computer over the network) ---
# The host bridge runs on your home machine; the companion connects to it.
HOST_BRIDGE_URL=
HOST_BRIDGE_TOKEN=
